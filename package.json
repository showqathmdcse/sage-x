{
  "name": "aava-code",
  "version": "1.0.0",
  "description": "Multi-cloud AI coding assistant CLI - supports Azure OpenAI, Amazon Bedrock, GCP Vertex AI",
  "main": "dist/index.js",
  "bin": {
    "aava-code": "./dist/index.js",
    "sage-x": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "node -e \"\"",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "check-firebase": "node check-firebase-setup.js",
    "package:mac": "npx pkg dist/index.js --targets node18-macos-arm64 --output bin/aava-code-mac",
    "package:win": "npx pkg dist/index.js --targets node18-win-x64 --output bin/aava-code-win.exe",
    "package:linux": "npx pkg dist/index.js --targets node18-linux-x64 --output bin/aava-code-linux",
    "package:all": "npm run package:mac && npm run package:win && npm run package:linux"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-bedrock-runtime": "^3.750.0",
    "@google-cloud/vertexai": "^1.9.2",
    "@google/genai": "^2.8.0",
    "chalk": "^4.1.2",
    "commander": "^13.1.0",
    "conf": "^13.1.0",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "glob": "^11.0.0",
    "inquirer": "^8.2.6",
    "marked": "^15.0.0",
    "marked-terminal": "^7.3.0",
    "openai": "^4.85.0",
    "ora": "^5.4.1",
    "readline": "^1.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.19.21",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/showqathmdcse/aava-code.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
